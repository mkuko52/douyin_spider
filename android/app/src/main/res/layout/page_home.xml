<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：品牌问候 + 登录态大圆 + 统计 + 2×2 快捷卡 + 登录状态两行。
     结构与外观都在 XML；点击逻辑在 Java 里按 id 绑定。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="18dp">

        <!-- 品牌 + 问候 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Douyin Spider"
            android:textColor="@color/dy_text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="今天也顺顺利利"
            android:textColor="@color/dy_text_muted"
            android:textSize="12sp" />

        <!-- 登录态大圆 -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_hero_circle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="检测中"
                    android:textColor="@color/dy_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="正在连接本地服务…"
                    android:textColor="#D9FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/home_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/dy_text_muted" />

        <!-- 快捷操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快捷操作"
                android:textColor="@color/dy_text_main"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                style="@style/DyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="点一下就到" />
        </LinearLayout>

        <!-- 2×2 卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="搜索采集"
                    android:textColor="@color/dy_text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/DyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关键词 → 列表" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数据筛选"
                    android:textColor="@color/dy_text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/DyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="字段 → 导出" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="导出 CSV"
                    android:textColor="@color/dy_text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/DyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="去重后下载" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_proxy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账号代理"
                    android:textColor="@color/dy_text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/DyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="多账号 + 代理池" />
            </LinearLayout>
        </LinearLayout>

        <!-- 登录状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="登录状态"
                android:textColor="@color/dy_text_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/row_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="登录 / 取态"
                    android:textColor="@color/dy_text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/DyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="扫码或短信登录后取 cookie" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_refresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="刷新状态"
                    android:textColor="@color/dy_text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/DyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重查登录态和本地库" />
            </LinearLayout>

            <!-- 其余状态文本（Java 里用 status() 写它） -->
            <TextView
                android:id="@+id/profile_status"
                style="@style/DyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
